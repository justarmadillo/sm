  "cards": [
    {
      "dot": "emerald",
      "title": "How to read this map",
      "items": [
        "Screens do not write SQLite directly: feature command runners own changes and transactions",
        "Queries read; commands change — both use repository contracts",
        "The pure document and scheduling layers contain rules, not Flutter or SQL"
      ]
    },
    {
      "dot": "cyan",
      "title": "Content vs learning",
      "items": [
        "Content tables hold what the user reads, extracts, watches, or answers",
        "Learning tables hold when each element is due and its scheduler state",
        "Every element gets a common schedule row; topic and card details live beside it"
      ]
    },
    {
      "dot": "rose",
      "title": "Durability boundary",
      "items": [
        "Append-only history explains what happened and supports undo or replay",
        "Images live as hash-named files while SQLite stores their metadata",
        "Startup makes validated backups before the session begins writing"
      ]
    }
  ]
